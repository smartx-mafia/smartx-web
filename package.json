{
  "name": "smartx-web-main",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "trans": "npm run extract && npm run compile",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:blog",
    "test:blog": "tsc -p tsconfig.blog-tests.json && node --test .test-dist/tests/blog/*.test.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@lingui/core": "^5.9.5",
    "@lingui/message-utils": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "next": "15.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@lingui/cli": "^5.9.5",
    "@lingui/swc-plugin": "^5.7.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.12",
    "sharp": "0.35.0"
  }
}
